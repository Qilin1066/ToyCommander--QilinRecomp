@echo off
rem Play @TITLE@: double-click. The first time it builds the game from
rem your disc dump (a few minutes); after that it just starts it.
setlocal
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "kit\play.ps1" %*
if errorlevel 1 (
    echo.
    echo Something stopped the build: the red line above says what.
    pause
)
