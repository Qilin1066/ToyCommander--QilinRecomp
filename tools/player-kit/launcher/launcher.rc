// The launcher's resources: its icon (make_icon.py draws it), the details
// Windows shows in the file's properties, and its manifest.
#include <winver.h>

1 ICON "launcher.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "QilinRecomp"
            VALUE "FileDescription", "QilinRecomp launcher: builds the game from your own copy and starts it"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "qilin_launcher"
            VALUE "LegalCopyright", "GPL-3.0-or-later. No game data is included."
            VALUE "OriginalFilename", "qilin_launcher.exe"
            VALUE "ProductName", "QilinRecomp"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
