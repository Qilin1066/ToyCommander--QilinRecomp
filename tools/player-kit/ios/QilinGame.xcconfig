// The game's iPadOS and iOS app, as the iOS kit's Xcode project builds it
// (included by Game.xcconfig, which tools/player-kit/package-ios-kit.sh
// writes for each game). The app is two static libraries and this folder's
// Info.plist and icon: QILIN_LIFTED_LIB, the player's lifted code (compiled
// with the kit's build-flags.txt), and QILIN_KIT_LIB, everything else
// (lib<game>_ios_kit.a). xcodebuild's command line sets both, and the team,
// the bundle identifier and the product name (README-ios.txt).

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 16.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO

INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_DEBUG_DYLIB = NO
ENABLE_BITCODE = NO
DEAD_CODE_STRIPPING = YES
CLANG_ENABLE_MODULES = NO
ALWAYS_SEARCH_USER_PATHS = NO

// Signed by Xcode with the player's team (DEVELOPMENT_TEAM, and
// -allowProvisioningUpdates for the profile). CI builds unsigned
// (CODE_SIGNING_ALLOWED=NO).
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

// The two libraries, then what they need: the C++ library, iconv (SDL), and
// the system's frameworks SDL3 and MoltenVK use. -ObjC: every Objective-C
// class and category in the archives (SDL's are found by name at run time).
QILIN_LIFTED_LIB =
QILIN_KIT_LIB = $(PROJECT_DIR)/../lib/lib$(QILIN_GAME)_ios_kit.a
OTHER_LDFLAGS = -ObjC "$(QILIN_LIFTED_LIB)" "$(QILIN_KIT_LIB)" -lc++ -liconv -framework UIKit -framework Foundation -framework QuartzCore -framework Metal -framework IOSurface -framework CoreGraphics -framework CoreVideo -framework CoreMedia -framework CoreAudio -framework AudioToolbox -framework AVFoundation -framework CoreMotion -framework GameController -weak_framework CoreHaptics
